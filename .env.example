# Configuración opcional de Docker. Copiar como .env en la raíz solo para cambiar estos valores.
# La API lee apps/api/.env y el frontend apps/web/.env.local; son archivos distintos.
# Los valores predeterminados permiten iniciar Mailpit sin crear este archivo.

# Solo para PostgreSQL LOCAL, al activar el perfil local-db. No usar la contraseña de Supabase.
# Se asigna al crear el volumen por primera vez; cambiarla aquí no cambia una BD ya creada.
POSTGRES_PASSWORD=umsspira_local
POSTGRES_PORT=5432

# Solo se utiliza al activar el perfil redis.
# Si cambia el puerto, actualizar REDIS_URL en apps/api/.env.
REDIS_PORT=6379

# Si cambia el puerto SMTP, actualizar SMTP_URL en apps/api/.env.
MAILPIT_SMTP_PORT=1025
# Puerto de la bandeja de correos en el navegador.
MAILPIT_WEB_PORT=8025
