# Copiar como .env. Para trabajar localmente, completa las tres variables vacías.
# Cada equipo coloca aquí las conexiones de SU proyecto Supabase.

# Modo de Node: development en tu PC; production al publicar el servidor.
# Las pruebas asignan test automáticamente. Para desplegar, consulta README.md.
NODE_ENV=development

# Base de destino; NO es el nombre de una rama de Git:
# epic = base de pruebas del equipo; dev = base compartida de integración.
# production = base del sistema simulado real, donde se bloquea el seed de demostración.
# test = base de pruebas automatizadas. En tu PC normalmente deja epic.
APP_ENV=epic

# Puerto del backend. El frontend usa 3001; cambia este solo si 3000 está ocupado.
PORT=3000

# Origen del frontend permitido por CORS. Al publicar, coloca su URL pública.
# Para varios orígenes, sepáralos con comas, sin rutas después del dominio.
CORS_ORIGINS=http://localhost:3001

# Conexión PostgreSQL para la API: URL completa del pooler de transacciones, puerto 6543.
# Copia la URL de Supabase y reemplaza [YOUR-PASSWORD] por la contraseña de esa base.
DATABASE_URL=

# Conexión para migraciones y seeds: URL completa del pooler de sesiones, puerto 5432.
DIRECT_URL=

# Clave propia para firmar tokens; NO es una clave de Supabase ni la contraseña de la BD.
# Genera una vez con: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Pega el resultado aquí y conserva la misma clave entre arranques de este entorno.
AUTH_JWT_SECRET=
# Enlace de correccion para solicitudes observadas
CORRECTION_LINK_TTL_DAYS=7
WEB_BASE_URL=http://localhost:3001
