# Copy to .env and fill the values for your local environment.
NODE_ENV=development
APP_ENV=epic
PORT=3000
CORS_ORIGINS=http://localhost:3001

# PostgreSQL connections used by Prisma.
DATABASE_URL=
DIRECT_URL=
AUTH_JWT_SECRET=
WEB_BASE_URL=http://localhost:3001

# Optional SMTP configuration for local development.
CORRECTION_LINK_TTL_DAYS=7
# SMTP_URL=smtp://127.0.0.1:1025
# MAIL_FROM=UMSSPIRA <no-reply@umsspira.local>

# Optional Supabase modules restored from the HU2 branch.
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional vacancy indexing.
# Set when running the optional local Elasticsearch service.
# ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX_VACANTES=vacantes
