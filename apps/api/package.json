{
  "name": "api",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm prisma:generate && nest start --watch",
    "start": "node dist/main.js",
    "build": "pnpm prisma:generate && nest build",
    "lint": "eslint src test scripts prisma.config.ts",
    "typecheck": "pnpm prisma:generate && tsc --noEmit -p tsconfig.check.json",
    "test": "pnpm prisma:generate && jest --runInBand",
    "test:watch": "pnpm prisma:generate && jest --watch",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "account:create": "tsx scripts/accounts/create.ts",
    "auth:prune": "tsx scripts/accounts/prune-sessions.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"*.ts\" \"*.mjs\" \"*.cjs\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"*.ts\" \"*.mjs\" \"*.cjs\" \"*.json\"",
    "db:seed:demo": "tsx scripts/seed/demo.ts",
    "db:seed:informatica": "tsx scripts/seed/informatics.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@umsspira/shared-types": "workspace:*",
    "argon2": "0.45.1",
    "dotenv": "18.0.5",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "^10.1.2",
    "pdfmake": "0.2.23",
    "pg": "8.23.1",
    "reflect-metadata": "0.1.14",
    "rxjs": "7.8.2",
    "socket.io": "^4.8.4",
    "zod": "4.6.7",
    "@umsspira/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.22",
    "@types/express": "^4.17.21",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "0.2.13",
    "@types/pg": "8.23.1",
    "@types/supertest": "^6.0.3",
    "eslint": "10.12.0",
    "jest": "29.7.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "ts-jest": "29.2.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
