generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TipoRespaldo {
  FOTO
  QR
  DOCUMENTO

  @@map("enum(FOTO,QR,DOCUMENTO)")
}

enum DepartamentoExpedicion {
  LP
  CB
  SC
  OR
  PT
  TJ
  CH
  BE
  PD
  Extranjero

  @@map("enum(LP,CB,SC,OR,PT,TJ,CH,BE,PD,Extranjero)")
}

model Usuario {
  portadas_evento       PortadaEvento[]
  revisiones            Dictamen[]            @relation("dictamen_revisor")
  nombre                String?               @db.VarChar
  rol                   String?               @db.VarChar
  usuario_id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correo                String?               @unique @db.VarChar(254)
  estado                EstadoUsuario         @default(PENDIENTE)
  cuenta_acceso         CuentaAcceso?
  sesiones_acceso       SesionAcceso[]
  administrador_sistema AdministradorSistema?
  auditoria_registros   Auditoria[]

  administrador_de_carrera_registros  AdministradorDeCarrera[]   @relation("administrador_de_carrera_id_usuario_usuario")
  empresa_registros                   Empresa[]                  @relation("empresa_id_usuario_usuario")
  titulado                            Titulado?                  @relation("titulado_id_usuario_usuario")
  mentoria_solicitud_registros        MentoriaSolicitud[]        @relation("mentoria_solicitud_id_usuario_usuario")
  postulacion_registros               Postulacion[]              @relation("postulacion_id_usuario_usuario")
  evento_registros                    Evento[]                   @relation("evento_id_usuario_usuario")
  inscripcion_evento_registros        InscripcionEvento[]        @relation("inscripcion_evento_id_usuario_usuario")
  usuario_solicitud_registros         UsuarioSolicitud[]         @relation("usuario_solicitud_id_usuario_usuario")
  notificacion_registros              Notificacion[]             @relation("notificacion_id_usuario_usuario")
  dispositivo_registros               Dispositivo[]              @relation("dispositivo_usuario_id_usuario")
  conversacion_registros              Conversacion[]             @relation("conversacion_creado_por_usuario")
  participante_conversacion_registros ParticipanteConversacion[] @relation("participante_conversacion_usuario_id_usuario")
  mensaje_registros                   Mensaje[]                  @relation("mensaje_emisor_id_usuario")
  mensaje_estado_registros            MensajeEstado[]            @relation("mensaje_estado_usuario_id_usuario")

  password_reset_token_registros      PasswordResetToken[]
  password_reset_solicitud_registros  PasswordResetSolicitud[]
  password_reset_evento_registros     PasswordResetEvento[]

  @@map("usuario")
}

enum EstadoUsuario {
  PENDIENTE
  ACTIVO
  BLOQUEADO
  ELIMINADO

  @@map("estado_usuario")
}

enum EstadoSolicitudMentoria {
  PENDIENTE @map("pendiente")
  ACEPTADO  @map("aceptado")
  RECHAZADO @map("rechazado")
  CANCELADO @map("cancelado")

  @@map("estado_solicitud_mentoria")
}

enum EstadoConexionMentoria {
  ACTIVA     @map("activa")
  FINALIZADA @map("finalizada")

  @@map("estado_conexion_mentoria")
}

enum EstadoSesionMentoria {
  PROGRAMADO @map("programado")
  COMPLETADO @map("completado")
  CANCELADO  @map("cancelado")

  @@map("estado_sesion_mentoria")
}

model CuentaAcceso {
  id_usuario     String   @id @db.Uuid
  password_hash  String   @db.Text
  version        Int      @default(1)
  actualizada_en DateTime @default(now()) @db.Timestamptz(6)
  usuario        Usuario  @relation(fields: [id_usuario], references: [usuario_id], onDelete: Cascade)

  @@map("cuenta_acceso")
}

model RolAcceso {
  codigo     String       @id @db.VarChar(40)
  habilitado Boolean      @default(true)
  permisos   RolPermiso[]

  @@map("rol_acceso")
}

model PermisoAcceso {
  codigo     String       @id @db.VarChar(100)
  habilitado Boolean      @default(true)
  roles      RolPermiso[]

  @@map("permiso_acceso")
}

model RolPermiso {
  rol_codigo     String        @db.VarChar(40)
  permiso_codigo String        @db.VarChar(100)
  rol            RolAcceso     @relation(fields: [rol_codigo], references: [codigo], onDelete: Cascade)
  permiso        PermisoAcceso @relation(fields: [permiso_codigo], references: [codigo], onDelete: Cascade)

  @@id([rol_codigo, permiso_codigo])
  @@map("rol_permiso")
}

model SesionAcceso {
  id                   String             @id @db.Uuid
  id_usuario           String             @db.Uuid
  version_credenciales Int
  csrf_hash            String             @db.Char(64)
  creada_en            DateTime           @default(now()) @db.Timestamptz(6)
  renovada_en          DateTime           @default(now()) @db.Timestamptz(6)
  expira_en            DateTime           @db.Timestamptz(6)
  revocada_en          DateTime?          @db.Timestamptz(6)
  motivo_revocacion    String?            @db.VarChar(40)
  recordar             Boolean            @default(false)
  agente               String?            @db.VarChar(256)
  usuario              Usuario            @relation(fields: [id_usuario], references: [usuario_id], onDelete: Cascade)
  renovaciones         RenovacionAcceso[]

  @@index([id_usuario, revocada_en, expira_en])
  @@map("sesion_acceso")
}

model RenovacionAcceso {
  hash         String       @id @db.Char(64)
  id_sesion    String       @db.Uuid
  creada_en    DateTime     @default(now()) @db.Timestamptz(6)
  consumida_en DateTime?    @db.Timestamptz(6)
  sesion       SesionAcceso @relation(fields: [id_sesion], references: [id], onDelete: Cascade)

  @@index([id_sesion])
  @@map("renovacion_acceso")
}

model Carrera {
  nombre String? @db.VarChar
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  administrador_sistema_registros    AdministradorSistema[]   @relation("administrador_sistema_id_carrera_carrera")
  administrador_de_carrera_registros AdministradorDeCarrera[] @relation("administrador_de_carrera_id_carrera_carrera")
  reporte_registros                  Reporte[]                @relation("reporte_id_carrera_carrera")
  encuesta_registros                 Encuesta[]               @relation("encuesta_id_carrera_carrera")
  titulado_registros                 Titulado[]               @relation("titulado_id_carrera_carrera")
  detalle_solicitud_registros        DetalleSolicitud[]       @relation("detalle_solicitud_id_carrera_carrera")

  @@map("carrera")
}

model TipoArchivo {
  nombre String? @db.VarChar
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  curriculum_vitae_registros   CurriculumVitae[]   @relation("curriculum_vitae_id_tipo_archivo_tipo_archivo")
  documento_respaldo_registros DocumentoRespaldo[] @relation("documento_respaldo_id_tipo_archivo_tipo_archivo")

  @@map("tipo_archivo")
}

model ModalidadTrabajo {
  nombre String? @db.VarChar
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  requerimiento_laboral_registros RequerimientoLaboral[] @relation("requerimiento_laboral_id_modalidad_modalidad_trabajo")

  @@map("modalidad_trabajo")
}

model Area {
  nombre              String?   @db.VarChar
  padre_id            String?   @db.Uuid
  esta_activo         Boolean?
  fecha_creacion      DateTime? @db.Date
  fecha_actualizacion DateTime? @db.Date
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  padre                             Area?                    @relation("area_padre_id_area", fields: [padre_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "area_padre_id_fkey")
  hijos                             Area[]                   @relation("area_padre_id_area")
  perfil_area_registros             PerfilArea[]             @relation("perfil_area_area_id_area")
  mentor_area_registros             MentorArea[]             @relation("mentor_area_id_area_area")
  requerimiento_habilidad_registros RequerimientoHabilidad[] @relation("requerimiento_habilidad_id_area_area")
  palabra_clave_area_registros      PalabraClaveArea[]
  afinidad_radar_registros          AfinidadRadar[]

  @@map("area")
}

model AdministradorSistema {
  id_usuario String?  @unique @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  id_carrera String?  @db.Uuid
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  carrera                            Carrera?                  @relation("administrador_sistema_id_carrera_carrera", fields: [id_carrera], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "administrador_sistema_id_carrera_fkey")
  dictamen_registros                 Dictamen[]                @relation("dictamen_id_administrador_sistema_administrador_sistema")
  usuario                            Usuario?                  @relation(fields: [id_usuario], references: [usuario_id], onDelete: NoAction)
  auditoria_dictamen_registros       AuditoriaDictamen[]
  validacion_certificacion_registros ValidacionCertificacion[]

  @@map("administrador_sistema")
}

model AdministradorDeCarrera {
  id_usuario     String?   @db.Uuid
  id_carrera     String?   @db.Uuid
  estado         String?   @db.VarChar
  fecha_registro DateTime? @db.Date
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  usuario            Usuario?   @relation("administrador_de_carrera_id_usuario_usuario", fields: [id_usuario], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction, map: "administrador_de_carrera_id_usuario_fkey")
  carrera            Carrera?   @relation("administrador_de_carrera_id_carrera_carrera", fields: [id_carrera], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "administrador_de_carrera_id_carrera_fkey")
  reporte_registros  Reporte[]  @relation("reporte_id_administrador_administrador_de_carrera")
  encuesta_registros Encuesta[] @relation("encuesta_id_administrador_administrador_de_carrera")

  @@map("administrador_de_carrera")
}

model TipoReporte {
  nombre         String?  @db.VarChar
  descripcion    String?  @db.VarChar
  disponibilidad Boolean?
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  reporte_registros Reporte[] @relation("reporte_id_tipo_reporte_tipo_reporte")

  @@map("tipo_reporte")
}

model Reporte {
  id_administrador String?   @db.Uuid
  id_tipo_reporte  String?   @db.Uuid
  id_carrera       String?   @db.Uuid
  fecha_creacion   DateTime? @db.Date
  formato          String?   @db.VarChar
  archivo_url      String?   @db.Text
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  administrador_de_carrera AdministradorDeCarrera? @relation("reporte_id_administrador_administrador_de_carrera", fields: [id_administrador], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "reporte_id_administrador_fkey")
  tipo_reporte             TipoReporte?            @relation("reporte_id_tipo_reporte_tipo_reporte", fields: [id_tipo_reporte], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "reporte_id_tipo_reporte_fkey")
  carrera                  Carrera?                @relation("reporte_id_carrera_carrera", fields: [id_carrera], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "reporte_id_carrera_fkey")

  @@map("reporte")
}

model Encuesta {
  condicion_laboral Boolean?
  cargo             String?   @db.VarChar(150)
  empresa           String?   @db.VarChar(200)
  area              String?   @db.VarChar(150)
  modalidad         String?   @db.VarChar(20)
  salario_mensual   String?   @db.VarChar(30)
  tiempo_insercion  String?   @db.VarChar(40)
  id_administrador  String?   @db.Uuid
  id_carrera        String?   @db.Uuid
  titulo            String?   @db.VarChar
  fecha_inicio      DateTime? @db.Date
  fecha_fin         DateTime? @db.Date
  estado            String?   @db.VarChar
  fecha_creacion    DateTime? @db.Date
  formato           String?   @db.VarChar
  direccion_url     String?   @db.Text
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  administrador_de_carrera AdministradorDeCarrera? @relation("encuesta_id_administrador_administrador_de_carrera", fields: [id_administrador], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "encuesta_id_administrador_fkey")
  carrera                  Carrera?                @relation("encuesta_id_carrera_carrera", fields: [id_carrera], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "encuesta_id_carrera_fkey")

  @@map("encuesta")
}

model Empresa {
  id_usuario          String?   @db.Uuid
  razon_social        String?   @db.VarChar
  nit                 String?   @db.VarChar
  descripcion         String?   @db.VarChar
  correo              String?   @db.VarChar
  sitio_web           String?   @db.VarChar
  fecha_registro      DateTime? @db.Timestamp(6)
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eslogan             String?   @db.VarChar
  logo_url            String?   @db.Text
  banner_url          String?   @db.Text
  tamano_empresa      String?   @db.VarChar
  descripcion_larga   String?   @db.Text
  fecha_actualizacion DateTime? @default(now()) @db.Timestamp(6)

  usuario                         Usuario?               @relation("empresa_id_usuario_usuario", fields: [id_usuario], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction, map: "empresa_id_usuario_fkey")
  telefono_empresa_registros      TelefonoEmpresa[]      @relation("telefono_empresa_id_empresa_empresa")
  sector_empresa_registros        SectorEmpresa[]        @relation("sector_empresa_id_empresa_empresa")
  direccion_empresa_registros     DireccionEmpresa[]     @relation("direccion_empresa_id_empresa_empresa")
  perfil_empresa_registros        PerfilEmpresa[]        @relation("perfil_empresa_id_empresa_empresa")
  requerimiento_laboral_registros RequerimientoLaboral[] @relation("requerimiento_laboral_id_empresa_empresa")
  vacante_registros               Vacante[]              @relation("vacante_id_empresa_empresa")

  @@map("empresa")
}

model TelefonoEmpresa {
  id_empresa String? @db.Uuid
  numero     String? @db.VarChar
  tipo       String? @db.VarChar
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  empresa Empresa? @relation("telefono_empresa_id_empresa_empresa", fields: [id_empresa], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "telefono_empresa_id_empresa_fkey")

  @@map("telefono_empresa")
}

model SectorEmpresa {
  id_empresa  String? @db.Uuid
  nombre      String? @db.VarChar
  descripcion String? @db.VarChar
  estado      String? @db.VarChar
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  empresa Empresa? @relation("sector_empresa_id_empresa_empresa", fields: [id_empresa], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sector_empresa_id_empresa_fkey")

  @@map("sector_empresa")
}

model DireccionEmpresa {
  id_empresa   String? @db.Uuid
  departamento String? @db.VarChar
  direccion    String? @db.VarChar
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  empresa Empresa? @relation("direccion_empresa_id_empresa_empresa", fields: [id_empresa], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "direccion_empresa_id_empresa_fkey")

  @@map("direccion_empresa")
}

model PerfilEmpresa {
  id_empresa     String?   @db.Uuid
  nombre         String?   @db.VarChar
  apellido       String?   @db.VarChar
  correo         String?   @db.VarChar
  contrasenia    String?   @db.VarChar
  cargo          String?   @db.VarChar
  estado         String?   @db.VarChar
  fecha_creacion DateTime? @db.Timestamp(6)
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  empresa Empresa? @relation("perfil_empresa_id_empresa_empresa", fields: [id_empresa], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "perfil_empresa_id_empresa_fkey")

  @@map("perfil_empresa")
}

model Titulado {
  anio_egreso         Int?     @db.SmallInt
  expedido_en         String?  @db.VarChar(20)
  rechazos_acumulados Int      @default(0) @db.SmallInt
  bloqueado           Boolean  @default(false)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  mentor              Mentor?
  id_descripcion      String?  @db.Uuid
  apellido            String?  @db.VarChar
  cod_sis             Decimal? @db.Decimal
  id_carrera          String?  @db.Uuid
  ci                  String?  @db.VarChar
  extension_ci        String?  @db.VarChar
  anio_ingreso        Int?     @db.SmallInt
  grado               String?  @db.VarChar
  id_usuario          String?  @unique @db.Uuid
  nombre              String?  @db.VarChar
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  carrera                            Carrera?                @relation("titulado_id_carrera_carrera", fields: [id_carrera], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "titulado_id_carrera_fkey")
  usuario                            Usuario?                @relation("titulado_id_usuario_usuario", fields: [id_usuario], references: [usuario_id], onDelete: NoAction, onUpdate: NoAction, map: "titulado_id_usuario_fkey")
  curriculum_vitae                   CurriculumVitae?        @relation("curriculum_vitae_id_titulado_titulado")
  formacion_academica_registros      FormacionAcademica[]    @relation("formacion_academica_id_titulado_titulado")
  experiencia_laboral_registros      ExperienciaLaboral[]    @relation("experiencia_laboral_id_titulado_titulado")
  certificacion_registros            Certificacion[]         @relation("certificacion_id_titulado_titulado")
  perfil_area_registros              PerfilArea[]            @relation("perfil_area_id_titulado_titulado")
  solicitud_registros                Solicitud[]             @relation("solicitud_titulado")
  calculo_radar_registros            CalculoRadar[]
  palabra_clave_no_mapeada_registros PalabraClaveNoMapeada[]

  @@map("titulado")
}

model CurriculumVitae {
  id_tipo_archivo String?  @db.Uuid
  ruta            String?  @db.Text
  valido          Boolean?
  id_titulado     String?  @unique @db.Uuid
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tipo_archivo TipoArchivo? @relation("curriculum_vitae_id_tipo_archivo_tipo_archivo", fields: [id_tipo_archivo], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "curriculum_vitae_id_tipo_archivo_fkey")
  titulado     Titulado?    @relation("curriculum_vitae_id_titulado_titulado", fields: [id_titulado], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "curriculum_vitae_id_titulado_fkey")

  @@map("curriculum_vitae")
}

model FormacionAcademica {
  institucion    String    @db.VarChar(150)
  titulo         String    @db.VarChar(150)
  anio_egreso    Int       @db.SmallInt
  fecha_creacion DateTime? @default(now()) @db.Timestamp(6)
  grado          String?   @db.VarChar(50)
  id_titulado    String    @db.Uuid
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  titulado           Titulado            @relation("formacion_academica_id_titulado_titulado", fields: [id_titulado], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "formacion_academica_id_titulado_fkey")
  respaldo_registros FormacionRespaldo[]

  @@map("formacion_academica")
}

model FormacionRespaldo {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_formacion String    @db.Uuid
  tipo         String    @db.VarChar(20)
  archivo_key  String    @db.VarChar(255)
  fecha_subida DateTime? @default(now()) @db.Timestamp(6)

  formacion FormacionAcademica @relation(fields: [id_formacion], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_formacion])
  @@map("formacion_respaldo")
}

model ExperienciaLaboral {
  empresa        String    @db.VarChar(150)
  cargo          String    @db.VarChar(100)
  fecha_inicio   DateTime  @db.Date
  fecha_fin      DateTime? @db.Date
  fecha_creacion DateTime? @default(now()) @db.Timestamp(6)
  id_titulado    String    @db.Uuid
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  titulado Titulado @relation("experiencia_laboral_id_titulado_titulado", fields: [id_titulado], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "experiencia_laboral_id_titulado_fkey")

  @@map("experiencia_laboral")
}

model Certificacion {
  nombre            String    @db.VarChar(150)
  id_titulado       String    @db.Uuid
  entidad_emisora   String    @db.VarChar(150)
  grado             String    @db.VarChar(50)
  anio_emision      Int?      @db.SmallInt
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha_creacion    DateTime? @default(now()) @db.Timestamp(6)
  estado_validacion String    @default("sin_respaldo") @db.VarChar(20)

  titulado                         Titulado                  @relation("certificacion_id_titulado_titulado", fields: [id_titulado], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "certificacion_id_titulado_fkey")
  certificacion_respaldo_registros CertificacionRespaldo[]   @relation("certificacion_respaldo_id_certificacion_certificacion")
  validacion_registros             ValidacionCertificacion[]

  @@map("certificacion")
}

model CertificacionRespaldo {
  archivo          ArchivoPerfil?
  tipo             TipoRespaldo
  archivo_key      String         @db.VarChar(255)
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha_subida     DateTime?      @default(now()) @db.Timestamp(6)
  id_certificacion String         @db.Uuid

  certificacion Certificacion @relation("certificacion_respaldo_id_certificacion_certificacion", fields: [id_certificacion], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "certificacion_respaldo_id_certificacion_fkey")

  @@map("certificacion_respaldo")
}

model ValidacionCertificacion {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_certificacion         String   @db.Uuid
  id_administrador_sistema String   @db.Uuid
  estado                   String   @db.VarChar(20)
  justificacion            String?  @db.Text
  fecha_creacion           DateTime @default(now()) @db.Timestamp(6)

