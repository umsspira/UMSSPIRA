// ============================================================
// Recuperación de contraseña (HU-12)
// ============================================================

model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_usuario  String    @db.Uuid
  token_hash  String    @unique @db.Text
  expira_en   DateTime  @db.Timestamptz(6)
  usado_en    DateTime? @db.Timestamptz(6)
  revocado    Boolean   @default(false)
  creado_en   DateTime  @default(now()) @db.Timestamptz(6)

  usuario     Usuario               @relation(fields: [id_usuario], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction)
  correos     PasswordResetCorreo[]

  @@index([id_usuario, creado_en(sort: Desc)], map: "idx_prt_usuario")
  @@map("password_reset_token")
}

model PasswordResetSolicitud {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correo_normalizado  String   @db.VarChar(255)
  origen_hash         String   @db.VarChar(64)
  usuario_id          String?  @db.Uuid
  resultado           String   @default("solicitado") @db.VarChar(30)
  creado_en           DateTime @default(now()) @db.Timestamptz(6)

  usuario             Usuario? @relation(fields: [usuario_id], references: [usuario_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([correo_normalizado, creado_en(sort: Desc)], map: "idx_prs_correo_ventana")
  @@index([origen_hash, creado_en(sort: Desc)], map: "idx_prs_origen_ventana")
  @@map("password_reset_solicitud")
}

model PasswordResetEvento {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id          String?  @db.Uuid
  correo_normalizado  String?  @db.VarChar(255)
  tipo                String   @db.VarChar(30)
  metadata            Json?    @db.JsonB
  creado_en           DateTime @default(now()) @db.Timestamptz(6)

  usuario             Usuario? @relation(fields: [usuario_id], references: [usuario_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([usuario_id, creado_en(sort: Desc)], map: "idx_pre_usuario")
  @@index([correo_normalizado, creado_en(sort: Desc)], map: "idx_pre_correo")
  @@map("password_reset_evento")
}

model PasswordResetCorreo {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_token              String    @db.Uuid
  email_destino         String    @db.VarChar(255)
  asunto                String    @db.VarChar(255)
  cuerpo                String?   @db.Text
  estado                String    @default("pendiente") @db.VarChar(20)
  intentos              Int       @default(0) @db.SmallInt
  max_intentos          Int       @default(3) @db.SmallInt
  siguiente_intento_en  DateTime  @default(now()) @db.Timestamptz(6)
  smtp_message_id       String?   @db.VarChar(255)
  ultimo_error          String?   @db.Text
  fecha_envio           DateTime? @db.Timestamptz(6)
  creado_en             DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en        DateTime  @default(now()) @db.Timestamptz(6)

  token                 PasswordResetToken @relation(fields: [id_token], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id_token], map: "uq_prc_un_correo_por_token")
  @@index([estado, siguiente_intento_en], map: "idx_prc_pendientes") 
  @@map("password_reset_correo")
}

model ControlReenvioOtp {
  id_solicitud        String    @id @db.Uuid
  generaciones_ciclo  Int       @default(0) @db.SmallInt
  nivel_bloqueo       Int       @default(0) @db.SmallInt
  enfriamiento_hasta  DateTime? @db.Timestamptz(6)
  bloqueado_hasta     DateTime? @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)

  solicitud           Solicitud @relation(fields: [id_solicitud], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("control_reenvio_otp")
}
