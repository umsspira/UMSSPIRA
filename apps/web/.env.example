# URL base de la API. Reiniciar next dev después de modificar .env.local.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Habilitar controles de simulación del radar solo en desarrollo y demos.
# La bandera se ignora en builds de producción.
NEXT_PUBLIC_ENABLE_SIMULATION_CONTROLS=false

# Solo para pruebas automatizadas de Jest. Los builds de Next ignoran esta
# bandera y siempre consultan la API real de afinidad.
NEXT_PUBLIC_USE_AFFINITY_MOCK=false
