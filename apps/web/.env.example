# URL base de la API. Reiniciar next dev después de modificar .env.local.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Habilitar controles de simulación del radar en desarrollo y demos
NEXT_PUBLIC_ENABLE_SIMULATION_CONTROLS=false

# Clave pública VAPID para suscribir notificaciones Push (HU13).
# Debe coincidir exactamente con VAPID_PUBLIC_KEY de apps/api/.env.
# Generar el par una vez con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

