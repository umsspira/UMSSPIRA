meta {
  name: Negativo - Empresa intenta modo titulado
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/affinity/batch
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "mode": "vacancies",
    "vacancyIds": ["{{vacancyId}}"]
  }
}

tests {
  test("Empresa debe recibir 403", () {
    expect(res.status).to.equal(403);
  });
}

docs {
  Ejecutar con accessToken de empresa. Caso negativo de autorización por modo.
}
