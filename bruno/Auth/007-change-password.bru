meta {
  name: Cambiar contraseña
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "currentPassword": "{{password}}",
    "newPassword": "{{newPassword}}"
  }
}

docs {
  newPassword debe tener de 15 a 128 caracteres y ser diferente. Esta operación revoca las sesiones; vuelve a iniciar sesión con la nueva contraseña.
}
