meta {
  name: Solicitar enlace con correo inexistente
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/auth/password-recovery/request
  body: json
  auth: none
}

body:json {
  {
    "email": "no.existe.bug17@example.com"
  }
}

docs {
  Debe responder igual que con una cuenta activa (202 y el mismo mensaje) y no enviar ningún correo.
  Sirve para comprobar que la ruta no revela si la cuenta existe.
}

tests {
  test("Responde 202 genérico sin revelar que la cuenta no existe", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getBody().data.message).to.be.a("string");
  });
}