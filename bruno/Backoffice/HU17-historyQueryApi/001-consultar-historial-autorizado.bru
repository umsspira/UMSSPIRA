meta {
  name: HU17 - Historial de solicitud autorizada (200)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/applications/{{applicationId}}/history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  const response = res.getBody();
  const data = response?.data;

  test("HU17: HTTP 200 para administrador de la carrera", function () {
    expect(res.getStatus()).to.equal(200);
  });


  test("HU17: identifica solicitud y version", function () {
    expect(data).to.be.an("object");

    const expectedId = bru.getEnvVar("applicationId");

    expect(expectedId).to.be.a("string");
    expect(data.applicationId).to.equal(expectedId);
    expect(data.currentVersion).to.be.a("number");
    expect(data.currentVersion).to.be.greaterThan(0);
  });


  test("HU17: estructura del ultimo OCR", function () {
    expect(data.ocr).to.be.an("object");
    expect(data.ocr).to.have.property("latestAnalysis");
    expect(data.ocr).to.have.property("latestResult");
    const latest = data.ocr.latestAnalysis;
    if (latest !== null) {
      expect(latest.version).to.be.a("number");
      expect(latest.status).to.be.a("string");
      expect(latest).to.have.property("startedAt");
      expect(latest).to.have.property("completedAt");
    }
    const result = data.ocr.latestResult;
    if (result !== null) {
      expect(result.version).to.be.a("number");
      expect(result.isCurrent).to.equal(result.version === data.currentVersion);
      expect(result.comparedData).to.be.an("array");
      expect(result).to.have.property("suggestion");
      expect(result).to.have.property("reason");
      expect(result).to.have.property("analyzedAt");
    }
  });

  test("HU17: cantidad de movimientos coincide", function () {
    expect(data.events).to.be.an("array");
    expect(data.eventCount).to.equal(data.events.length);
  });

  test("HU17: movimientos mas recientes primero", function () {
    const events = data.events;
    for (let i = 1; i < events.length; i++) {
      expect(Date.parse(events[i - 1].occurredAt)).to.be.at.least(
        Date.parse(events[i].occurredAt)
      );
    }
  });

  test("HU17: cada evento identifica actor, fecha y version", function () {
    data.events.forEach((event) => {
      expect(event.id).to.be.a("string");
      expect(event.version).to.be.a("number");
      expect(event.version).to.be.greaterThan(0);
      expect(event.version).to.be.at.most(data.currentVersion);
      expect(event.action).to.be.a("string");
      expect(event.title).to.be.a("string");
      expect(event).to.have.property("description");
      expect(event.actor).to.be.an("object");
      expect(event.actor.type).to.be.a("string");
      expect(event.actor).to.have.property("id");
      expect(event.occurredAt).to.be.a("string");
      expect(Number.isNaN(Date.parse(event.occurredAt))).to.equal(false);
    });
  });
}

docs {
  Requiere accessToken de administrador autorizado y applicationId real
  de su carrera. Reutiliza las mismas variables de Backoffice.
  Prueba el contrato de lectura del historial y el orden descendente.
  IMPORTANTE: permite OCR nulo y eventos vacios; esto NO verifica que
  los productores de eventos registren OCR/dictamen/reenvio.
}
