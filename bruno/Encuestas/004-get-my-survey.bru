meta {
  name: Consultar encuesta enviada
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/surveys/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("devuelve si respondió y sus respuestas", function () {
    const body = res.getBody();
    expect(body?.data?.responded).to.be.a("boolean");
    if (body.data.responded) {
      expect(body.data.response).to.be.an("object");
      expect(body.data.response.condicion_laboral).to.be.a("boolean");
    } else {
      expect(body.data.response).to.equal(null);
    }
  });
}

docs {
  Usa el token de un titulado. Devuelve las respuestas guardadas de la encuesta vigente.
}