meta {
  name: Reporte de encuestas con token de titulado
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/reports/surveys?page=1&limit=10
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 10
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status 403", function () {
    expect(res.getStatus()).to.equal(403);
  });

  test("acceso prohibido", function () {
    const body = res.getBody();
    expect(body?.error?.code).to.equal("FORBIDDEN");
  });
}

docs {
  Caso negativo: un titulado no tiene el permiso reportes:read.
}
