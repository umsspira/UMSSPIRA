meta {
  name: Extraer keywords - 200 Texto de exactamente 5000 caracteres
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/nlp/extract
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "text": ""
  }
}

tests {
  test("Status 200 con exactamente 5000 caracteres", function() {
    expect(res.status).to.equal(200);
  });

  test("Esquema valido: keywords y unmapped presentes", function() {
    expect(res.body).to.have.property("keywords").that.is.an("array");
    expect(res.body).to.have.property("unmapped").that.is.an("array");
  });
}

docs {
  HU-1 · T1.7 — Texto de exactamente 5 000 caracteres (limite superior permitido).
  Debe responder 200 OK; el limite es estricto menor a 5 001.

  CA-HU5-19: texto con exactamente 5 000 chars -> 200 OK (limite superior inclusivo).
  Complementa el test 004 que prueba 5 001 chars -> 400.

  Permiso: nlp:extract.
}
