meta {
  name: Liberar trabajo fallido
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/applications/ocr/{{ocrJobId}}/fail
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{ocrToken}}"
  }
}

tests {
  test("HTTP 201", function () { expect(res.getStatus()).to.equal(201); });

}

docs {
  Requiere reservar OTRO trabajo ficticio mediante claim. La reserva del caso complete ya no sirve. Tras tres intentos fallidos, el trabajo queda FALLIDO para revision manual.
}
