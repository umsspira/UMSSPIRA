meta {
  name: Filtrar estados por carrera
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/applications/ocr/statuses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{otherCareerAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "ids": [
      "{{ocrApplicationId}}"
    ]
  }
}

tests {
  test("HTTP 201", function () { expect(res.getStatus()).to.equal(201); });
  test("No filtra informacion de otra carrera", function () { expect(res.getBody().data).to.deep.equal([]); });
}

docs {
  ocrApplicationId pertenece a una carrera fuera del alcance de otherCareerAccessToken.
}
