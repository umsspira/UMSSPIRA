meta {
  name: Validar confianza OCR
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/applications/ocr/{{ocrJobId}}/complete
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{ocrToken}}",
    "reading": {
      "lines": [
        {
          "text": "dato",
          "confidence": 2,
          "page": 1
        }
      ],
      "pagesRead": 1,
      "totalPages": 1,
      "partial": false,
      "engine": "PaddleOCR.js@0.4.2/PP-OCRv6_small/es",
      "loadMs": 1,
      "readMs": 1
    }
  }
}

tests {
  test("HTTP 400", function () { expect(res.getStatus()).to.equal(400); });

}

docs {
  Usar exclusivamente solicitudes ficticias. Requiere baseUrl y accessToken; ejecutar claim tras enviar una solicitud pendiente.
}
