meta {
  name: Agregar formación académica
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/perfil/formacion-academica
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "institucion": "Universidad Mayor de San Simón",
    "titulo": "Ingeniería de Sistemas",
    "grado": "Licenciatura",
    "anioEgreso": 2025
  }
}

docs {
  Copia el UUID del registro creado a profileRecordId y usa profileSection=formacion-academica para consultarlo, editarlo o eliminarlo.

  Permiso: perfil:self:write.
}
