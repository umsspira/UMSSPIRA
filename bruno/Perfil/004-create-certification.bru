meta {
  name: Agregar certificación
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/perfil/certificaciones
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "nombre": "Desarrollo de aplicaciones",
    "entidadEmisora": "Instituto de formación",
    "grado": "Certificación",
    "anioEmision": 2025
  }
}

docs {
  Copia el UUID creado a certificationId para su respaldo y a profileRecordId para operaciones genéricas; usa profileSection=certificaciones.

  Permiso: perfil:self:write.
}
