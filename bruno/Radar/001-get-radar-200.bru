meta {
  name: GET radar - 200 radar con keywords (estado ok)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/radar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data) {
    bru.setVar("radarGraduateId", res.body.data.graduateId);
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Respuesta envuelta en data", function() {
    expect(res.body).to.have.property("data").that.is.an("object");
  });

  test("Esquema: graduateId, calculatedAt, status, algorithmVersion y hasPendingChanges", function() {
    const d = res.body.data;
    expect(d.graduateId).to.be.a("string").that.is.not.empty;
    expect(Number.isNaN(Date.parse(d.calculatedAt))).to.equal(false);
    expect(d.status).to.equal("ok");
    expect(d.algorithmVersion).to.be.a("string").that.is.not.empty;
    expect(d.hasPendingChanges).to.be.a("boolean");
  });

  test("Los 6 ejes de afinidad vienen en el orden fijo esperado", function() {
    const areas = res.body.data.areas;
    expect(areas).to.be.an("array").with.lengthOf(6);

    const ordenEsperado = [
      "software-development",
      "cloud-devops",
      "data-ai",
      "quality-assurance",
      "cybersecurity-networks",
      "it-management"
    ];
    expect(areas.map(function(a) { return a.area; })).to.deep.equal(ordenEsperado);
  });

  test("Cada eje incluye affinity, previousAffinity, weighting y topKeywords (máx. 5, aporte > 0, orden descendente)", function() {
    const areas = res.body.data.areas;
    areas.forEach(function(a) {
      expect(a.affinity).to.be.a("number");
      expect(a.affinity).to.be.within(0, 100);
      if (a.previousAffinity !== null) {
        expect(a.previousAffinity).to.be.a("number");
        expect(a.previousAffinity).to.be.within(0, 100);
      }
      if (a.weighting !== null) {
        expect(a.weighting).to.be.a("number");
        expect(a.weighting).to.be.within(1, 5);
      }
      expect(a.topKeywords).to.be.an("array");
      expect(a.topKeywords.length).to.be.at.most(5);

      const seenKeywords = [];
      a.topKeywords.forEach(function(k, index) {
        expect(k.keyword).to.be.a("string").that.is.not.empty;
        expect(seenKeywords).to.not.include(k.keyword);
        seenKeywords.push(k.keyword);

        expect(k.weight).to.be.a("number").and.to.be.within(1, 5);
        expect(k.frequency).to.be.a("number").and.to.be.at.least(1);
        expect(k.points).to.be.a("number").and.to.be.above(0);
        expect(k.points).to.equal(k.weight * Math.min(k.frequency, 3));
        expect(k.percentage).to.be.a("number").and.to.be.above(0).and.to.be.at.most(100);

        if (index > 0) {
          const prev = a.topKeywords[index - 1];
          expect(prev.points).to.be.at.least(k.points);
          expect(prev.percentage).to.be.at.least(k.percentage);
          if (prev.points === k.points) {
            expect(prev.keyword <= k.keyword).to.equal(true);
          }
        }
      });
    });

    const conKeywords = areas.some(function(a) { return a.topKeywords.length > 0; });
    expect(conKeywords).to.equal(true);
  });
}
