meta {
  name: POST radar/recalculate - 200 recalcula el radar
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/radar/recalculate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data) {
    bru.setVar("radarCalculatedAt", res.body.data.calculatedAt);
    bru.setVar("radarPreviousAffinityJson", JSON.stringify(res.body.data.areas.map(function(a) {
      return [a.area, a.previousAffinity];
    })));
    bru.setVar("radarTopKeywordsJson", JSON.stringify(res.body.data.areas.map(function(a) {
      return [a.area, a.topKeywords];
    })));
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Respuesta envuelta en data", function() {
    expect(res.body).to.have.property("data").that.is.an("object");
  });

  test("Esquema: graduateId, calculatedAt, status, algorithmVersion y hasPendingChanges", function() {
    const d = res.body.data;
    expect(d.graduateId).to.be.a("string").that.is.not.empty;
    expect(Number.isNaN(Date.parse(d.calculatedAt))).to.equal(false);
    expect(["ok", "empty"]).to.include(d.status);
    expect(d.algorithmVersion).to.be.a("string").that.is.not.empty;
    expect(d.hasPendingChanges).to.be.a("boolean");
  });

  test("Siempre 6 areas con affinity entre 0 y 100", function() {
    const areas = res.body.data.areas;
    expect(areas).to.be.an("array").with.lengthOf(6);
    areas.forEach(function(a) {
      expect(a.affinity).to.be.a("number");
      expect(a.affinity).to.be.within(0, 100);
      if (a.weighting !== null) {
        expect(a.weighting).to.be.within(1, 5);
      }
      expect(a.topKeywords).to.be.an("array").with.lengthOf.at.most(5);
      if (a.previousAffinity !== null) {
        expect(a.previousAffinity).to.be.a("number").within(0, 100);
      }
    });
  });

  test("Keywords influyentes con el contrato de HU-8", function() {
    res.body.data.areas.forEach(function(a) {
      a.topKeywords.forEach(function(k) {
        expect(k).to.have.all.keys("keyword", "weight", "frequency", "points", "percentage");
        expect(k.keyword).to.be.a("string").that.is.not.empty;
        expect(k.weight).to.be.within(1, 5);
        expect(k.frequency).to.be.at.least(1);
        expect(k.points).to.be.at.least(1);
        expect(k.percentage).to.be.within(0, 100);
      });
    });
  });

  test("Las areas usan los slugs del contrato AffinityArea", function() {
    const esperados = ["software-development", "cloud-devops", "data-ai", "quality-assurance", "cybersecurity-networks", "it-management"];
    const recibidos = res.body.data.areas.map(function(a) { return a.area; });
    expect(recibidos.slice().sort()).to.eql(esperados.slice().sort());
  });

  test("recalculated es booleano y no quedan cambios pendientes", function() {
    expect(res.body.data.recalculated).to.be.a("boolean");
    expect(res.body.data.hasPendingChanges).to.equal(false);
  });

  test("Tiempo de respuesta menor o igual a 3 000 ms", function() {
    expect(res.responseTime).to.be.at.most(3000);
  });
}

docs {
  Usa el accessToken de un titulado. Recalcula con los textos actuales del perfil.
  Si el perfil no cambio desde el ultimo calculo, devuelve el calculo existente (recalculated = false).
  Guarda calculatedAt en radarCalculatedAt para el caso 007.

  Permiso: radar:self:write.
  CA-HU?-XX (pendiente: copiar del .md de QA): recalcular y esquema del vector.
}
