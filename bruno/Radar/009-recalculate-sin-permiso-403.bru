meta {
  name: POST radar/recalculate - 403 sin permiso
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/radar/recalculate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessTokenSinPermiso}}
}

tests {
  test("Status 403", function() {
    expect(res.status).to.equal(403);
  });

  test("Esquema de error { error: { code, message } }", function() {
    expect(res.body).to.have.property("error").that.is.an("object");
    expect(res.body.error.code).to.be.a("string").that.is.not.empty;
    expect(res.body.error.message).to.be.a("string").that.is.not.empty;
  });

  test("Codigo FORBIDDEN", function() {
    expect(res.body.error.code).to.equal("FORBIDDEN");
  });
}

docs {
  Requiere configurar manualmente {{accessTokenSinPermiso}} con el token de un usuario SIN radar:self:write (ej. empresa@umss.edu.bo).
  Si la variable esta vacia o el token tiene permiso, el test falla (no es un bug de la API).

  Permiso exigido: radar:self:write.
  CA-HU?-XX (pendiente: copiar del .md de QA): acceso sin permiso.
}
