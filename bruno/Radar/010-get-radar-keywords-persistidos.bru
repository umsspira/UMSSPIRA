meta {
  name: GET radar - 200 keywords y previousAffinity persistidos tras recálculo
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/radar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Conserva los 6 ejes en orden fijo, topKeywords (máx. 5, aporte > 0, orden descendente) y previousAffinity", function() {
    const d = res.body.data;
    expect(d.areas).to.be.an("array").with.lengthOf(6);

    const ordenEsperado = [
      "software-development",
      "cloud-devops",
      "data-ai",
      "quality-assurance",
      "cybersecurity-networks",
      "it-management"
    ];
    expect(d.areas.map(function(a) { return a.area; })).to.deep.equal(ordenEsperado);

    const prevJson = bru.getVar("radarPreviousAffinityJson");
    const topJson = bru.getVar("radarTopKeywordsJson");

    if (prevJson) {
      expect(
        JSON.stringify(d.areas.map(function(a) { return [a.area, a.previousAffinity]; }))
      ).to.equal(prevJson);
    }

    if (topJson) {
      expect(
        JSON.stringify(d.areas.map(function(a) { return [a.area, a.topKeywords]; }))
      ).to.equal(topJson);
    }

    d.areas.forEach(function(a) {
      expect(a.topKeywords).to.be.an("array");
      expect(a.topKeywords.length).to.be.at.most(5);
      a.topKeywords.forEach(function(k, index) {
        expect(k.points).to.be.above(0);
        expect(k.percentage).to.be.above(0).and.to.be.at.most(100);
        if (index > 0) {
          const prev = a.topKeywords[index - 1];
          expect(prev.points).to.be.at.least(k.points);
          expect(prev.percentage).to.be.at.least(k.percentage);
          if (prev.points === k.points) {
            expect(prev.keyword <= k.keyword).to.equal(true);
          }
        }
      });
    });
  });
}
