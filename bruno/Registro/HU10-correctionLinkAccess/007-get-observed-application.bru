meta {
  name: 007 - Obtener datos del expediente observado
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/registrations/observed
  body: none
  auth: none
}

headers {
  X-Correction-Token: {{validCorrectionToken}}
}

tests {
  test("Retorna datos de la solicitud observada y version", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.have.property('id');
    expect(res.getBody().data).to.have.property('version');
    expect(res.getBody().data).to.have.property('observacion');
  });
}

docs {
  Obtiene los datos editables, motivo de observacion y metadata de archivo de la solicitud observada, protegido por X-Correction-Token.
}
