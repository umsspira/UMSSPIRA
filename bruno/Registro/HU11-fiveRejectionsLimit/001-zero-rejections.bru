meta {
  name: HU-11 - Registro sin rechazos
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/registrations/sessions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombres": "{{hu11Nombres}}",
    "apellidos": "{{hu11Apellidos}}",
    "ci": "{{hu11Ci}}",
    "complementoCi": "{{hu11ComplementoCi}}",
    "expedidoEn": "{{hu11ExpedidoEn}}",
    "correo": "{{hu11Correo}}",
    "telefono": "{{hu11Telefono}}",
    "carreraId": "{{hu11CarreraId}}",
    "anioEgreso": {{hu11AnioEgreso}},
    "codigoSis": "{{hu11CodigoSis}}"
  }
}

tests {
  const body = res.getBody();

  test("HU-11: permite registro sin rechazos", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("HU-11: devuelve token de borrador", function () {
    expect(body?.data?.sessionToken).to.be.a("string");
  });
}
