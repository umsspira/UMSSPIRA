meta {
  name: HU-11 - Cambio de SIS no evita bloqueo
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/registrations/sessions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombres": "{{hu11Nombres}}",
    "apellidos": "{{hu11Apellidos}}",
    "ci": "{{hu11Ci}}",
    "complementoCi": "{{hu11ComplementoCi}}",
    "expedidoEn": "{{hu11ExpedidoEn}}",
    "correo": "{{hu11CorreoAlternativo}}",
    "telefono": "{{hu11TelefonoAlternativo}}",
    "carreraId": "{{hu11CarreraId}}",
    "anioEgreso": {{hu11AnioEgreso}},
    "codigoSis": "{{hu11SisAlternativo}}"
  }
}

tests {
  const body = res.getBody();

  test("HU-11: cambiar SIS no evita bloqueo", function () {
    expect(res.getStatus()).to.equal(409);
  });

  test("HU-11: bloquea por identidad civil", function () {
    expect(body?.error?.code).to.equal(
      "REJECTION_LIMIT_REACHED"
    );
  });

  test("HU-11: no genera borrador", function () {
    expect(body?.data?.sessionToken).to.be.undefined;
  });
}
