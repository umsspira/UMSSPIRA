meta {
  name: Iniciar sesion empresa
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{empresaEmail}}",
    "password": "{{empresaPassword}}",
    "remember": false
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data) {
    bru.setVar("empresaToken", res.body.data.accessToken);
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Guarda el token de la empresa en tiempo de ejecucion", function() {
    expect(res.body.data.accessToken).to.be.a("string").that.is.not.empty;
  });
}

docs {
  Inicia sesion con la cuenta de empresa y guarda data.accessToken en
  {{empresaToken}}. Completa empresaEmail y empresaPassword en folder.bru o en un
  entorno local. No escribas tokens en el repositorio.
}
