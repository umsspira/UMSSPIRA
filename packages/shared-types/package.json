{
  "name": "@umsspira/shared-types",
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    },
    "./src/*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
